# =============================================================================
# Variables de la stack VPN Benchmark
#
# Dans Portainer : recopie ces cles dans "Environment variables" de la stack.
# En local (docker compose) : copie ce fichier en .env et remplis-le.
#
# Toute variable laissee vide = valeur par defaut de bench.yaml pour le mode
# choisi. Il n'y a donc rien a remplir au-dela des deux cles WireGuard.
# =============================================================================

# --- OBLIGATOIRE -------------------------------------------------------------
# Cle privee WireGuard NordVPN (NordLynx) - voir README section 6
NORD_WIREGUARD_PRIVATE_KEY=
# Cle privee WireGuard ProtonVPN - voir README section 6
PROTON_WIREGUARD_PRIVATE_KEY=

# --- Environnement -----------------------------------------------------------
PROTON_WIREGUARD_ADDRESSES=10.2.0.2/32
LAN_SUBNET=192.168.1.0/24
TZ=Europe/Paris
GLUETUN_IMAGE=qmcgaw/gluetun:v3.40
# Port d'ecoute du rapport HTML sur le NAS (cote hote)
BENCH_WEB_PORT=8888
# Image utilisee par la stack ; par defaut celle publiee sur GHCR
BENCH_IMAGE=

# --- Campagne ----------------------------------------------------------------
# smoke = validation ~20 min | full = campagne ~24 h | report = regenere le rapport
BENCH_MODE=smoke
BENCH_COUNTRIES=
BENCH_ROUNDS=
BENCH_INTERVAL_MINUTES=
BENCH_SERVERS_PER_COUNTRY=
BENCH_INCLUDE_BASELINE=

# --- P2P ---------------------------------------------------------------------
BENCH_P2P_ENABLED=
BENCH_P2P_MINUTES=
BENCH_P2P_EVERY_ROUNDS=
BENCH_MAX_DOWNLOAD_GB=

# --- Reglage fin des mesures -------------------------------------------------
BENCH_THROUGHPUT_SECONDS=
BENCH_THROUGHPUT_STREAMS=
BENCH_LATENCY_COUNT=
BENCH_WEB_REPEATS=
BENCH_KILLSWITCH=

# --- Cibles (listes separees par des virgules) -------------------------------
BENCH_PING_TARGETS=
BENCH_WEB_URLS=
BENCH_TORRENTS=

# --- Interne (ne pas modifier sans raison) -----------------------------------
# BENCH_HTTP_PORT=8888          port d'ecoute DANS le conteneur
# BENCH_KEEP_ALIVE=true         false = le conteneur s'arrete a la fin du run
# BENCH_YAML=/config/bench.yaml chemin d'un bench.yaml personnalise
# BENCH_RESULTS=/app/results    dossier des resultats dans le conteneur
# BENCH_SELF_NAME=vpnbench-orchestrator  nom du conteneur, sert a l'auto-inspection
# BENCH_PROJECT=vpnbench        prefixe des conteneurs crees par l'orchestrateur
